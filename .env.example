# offline = deterministic planner and narrator (no key needed); live = LLM via any OpenAI-compatible endpoint
LLM_MODE=offline
OPENAI_API_KEY=
OPENAI_BASE_URL=          # e.g. an Azure OpenAI / Microsoft Foundry endpoint
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_S=25

DUCKDB_PATH=warehouse/insight.duckdb
APP_DB_PATH=warehouse/app.sqlite
MAX_ROWS=50
